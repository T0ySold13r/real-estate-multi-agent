# ============================================================
# REAL ESTATE MULTI-AGENT FRAMEWORK - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ------------------------------------------------------------
# ANTHROPIC (Required)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# PROPERTY DATA APIs (Optional - agents work without these)
# ------------------------------------------------------------
# Zillow RapidAPI (property values & estimates)
ZILLOW_API_KEY=your_zillow_rapidapi_key_here

# ATTOM Data Solutions (property details, tax records)
ATTOM_API_KEY=your_attom_api_key_here

# RentCast (rental comps & market data)
RENTCAST_API_KEY=your_rentcast_api_key_here

# Walk Score (neighborhood scoring)
WALKSCORE_API_KEY=your_walkscore_api_key_here

# ------------------------------------------------------------
# NOTIFICATIONS (Optional)
# ------------------------------------------------------------
# Email alerts for new deals
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL=alerts@yourdomain.com

# Slack webhook for deal notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ------------------------------------------------------------
# DATABASE (Optional - defaults to SQLite)
# ------------------------------------------------------------
# Leave blank to use local SQLite database
DATABASE_URL=sqlite:///./deals.db
# For PostgreSQL: postgresql://user:password@localhost/realestate

# ------------------------------------------------------------
# SEARCH SETTINGS
# ------------------------------------------------------------
# Comma-separated target states
TARGET_STATES=OH,MI,AL
# Maximum purchase price filter
MAX_PURCHASE_PRICE=10000
# Minimum cash-on-cash return %
MIN_CASH_ON_CASH=8
# Minimum monthly cash flow $
MIN_MONTHLY_CASHFLOW=400
# Scan interval in hours
SCAN_INTERVAL_HOURS=6
